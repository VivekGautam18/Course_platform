    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "export type UserRole = \'student\' | \'admin\';\n\nexport interface User {\n  id: string;\n  email: string;\n  name: string;\n  phone?: string;\n  role: UserRole;\n  attempt?: string;\n  college?: string;\n  preparationLevel?: string;\n  createdAt: string;\n}\n\nexport interface Video {\n  id: string;\n  title: string;\n  duration: string;\n  videoUrl: string;\n  isFreePreview?: boolean;\n  order: number;\n}\n\nexport interface PDFResource {\n  id: string;\n  title: string;\n  type: \'notes\' | \'question_bank\';\n  fileUrl: string;\n  pageCount?: number;\n  sizeMb?: string;\n}\n\nexport interface Chapter {\n  id: string;\n  title: string;\n  description: string;\n  videos: Video[];\n  pdfs: PDFResource[];\n}\n\nexport interface Course {\n  id: string;\n  title: string;\n  subject: string;\n  category: \'CA Inter\' | \'CA Final\';\n  group: \'Group 1\' | \'Group 2\' | \'Both Groups\';\n  description: string;\n  longDescription: string;\n  thumbnail: string;\n  duration: string;\n  price: number;\n  originalPrice: number;\n  rating: number;\n  reviewCount: number;\n  chapters: Chapter[];\n  isFeatured?: boolean;\n}\n\nexport interface MentorshipOption {\n  id: string;\n  examTerm: \'CA Inter Sept 2026\' | \'CA Inter Jan 2027\';\n  groupType: \'Single Group\' | \'Both Groups\';\n  price: number;\n  originalPrice: number;\n  description: string;\n  benefits: string[];\n  weeklyPlan: { week: string; topic: string; goal: string }[];\n}\n\nexport interface MentorshipEnrollment {\n  id: string;\n  userId: string;\n  studentName: string;\n  studentEmail: string;\n  mobile: string;\n  attempt: string;\n  college: string;\n  currentPreparationLevel: string;\n  mentorshipId: string;\n  mentorshipTitle: string;\n  amountPaid: number;\n  paymentId: string;\n  enrolledAt: string;\n  status: \'active\' | \'completed\';\n}\n\nexport interface StrategySessionBooking {\n  id: string;\n  userId: string;\n  studentName: string;\n  studentEmail: string;\n  contactNumber: string;\n  attempt: string;\n  date: string;\n  timeSlot: string;\n  primaryStruggle: string;\n  amountPaid: number;\n  paymentId: string;\n  bookedAt: string;\n  meetingLink?: string;\n  status: \'scheduled\' | \'completed\' | \'cancelled\';\n}\n\nexport interface Testimonial {\n  id: string;\n  studentName: string;\n  studentAttempt: string;\n  examScore?: string;\n  rating: number;\n  reviewText: string;\n  avatarUrl?: string;\n  whatsappScreenshotUrl?: string;\n  marksheetUrl?: string;\n  verifiedStudent: boolean;\n  date: string;\n}\n\nexport interface Payment {\n  id: string;\n  userId: string;\n  userEmail: string;\n  userName: string;\n  itemType: \'course\' | \'mentorship\' | \'strategy_session\';\n  itemId: string;\n  itemTitle: string;\n  amount: number;\n  razorpayPaymentId: string;\n  razorpayOrderId: string;\n  status: \'success\' | \'failed\';\n  createdAt: string;\n}\n\nexport interface StudentProgress {\n  userId: string;\n  courseId: string;\n  completedVideoIds: string[];\n  lastWatchedVideoId?: string;\n  lastWatchedTimestamp?: number;\n  overallProgressPercentage: number;\n  updatedAt: string;\n}\n\nexport interface UserPurchase {\n  userId: string;\n  courseIds: string[];\n  mentorshipIds: string[];\n  strategySessionIds: string[];\n}\n"
