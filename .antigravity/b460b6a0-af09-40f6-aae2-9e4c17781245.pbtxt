on value=\"CA Final\">CA Final</option>\n          </select>\n\n          <select\n            value={selectedGroup}\n            onChange={(e) => setSelectedGroup(e.target.value)}\n            className=\"px-3 py-2 text-xs font-semibold border border-slate-300 dark:border-slate-700 rounded-xl dark:bg-slate-900 dark:text-white\"\n          >\n            <option value=\"all\">All Groups</option>\n            <option value=\"Group 1\">Group 1</option>\n            <option value=\"Group 2\">Group 2</option>\n          </select>\n        </div>\n      </div>"
