      replacement_content: "import { Course, MentorshipOption, Testimonial } from \'../types\';\n\nexport const INITIAL_COURSES: Course[] = [\n  {\n    id: \'c1\',\n    title: \'CA Inter Income Tax & GST - Fastrack Mastery\',\n    subject: \'Taxation (DT & IDT)\',\n    category: \'CA Inter\',\n    group: \'Group 1\',\n    description: \'Complete syllabus coverage with Section-wise memory tricks, recent amendments, and 200+ case studies solved.\',\n    longDescription: \'Master CA Inter Taxation with Sneha Gupta (CA Finalist). Designed specifically for upcoming exam attempts, this course breaks down complex Income Tax provisions and GST rules into intuitive 5-minute concepts. Includes handcrafted summaries, MCQ tricks, and step-by-step numerical practice.\',\n    thumbnail: \'https://images.unsplash.com/photo-1554224155-8d04cb21cd6c?auto=format&fit=crop&w=800&q=80\',\n    duration: \'45 Hours\',\n    price: 1499,\n    originalPrice: 2999,\n    rating: 4.9,\n    reviewCount: 342,\n    isFeatured: true,\n    chapters: [\n      {\n        id: \'ch1\',\n        title: \'Basic Concepts & Heads of Income (DT)\',\n        description: \'Residential status, Salary, House Property, PGBP & Capital Gains with Section mnemonics.\',\n        videos: [\n          {\n            id: \'v1_1\',\n            title: \'1. Introduction to Income Tax & Amendments 2026\',\n            duration: \'28:40\',\n            videoUrl: \'https://commondatastorage.googleapis.com/gtv-videos-bucket/sample/BigBuckBunny.mp4\',\n            isFreePreview: true,\n            order: 1,\n          },\n          {\n            id: \'v1_2\',\n            title: \'2. Profits & Gains from Business or Profession (PGBP) Masterclass\',\n            duration: \'42:15\',\n            videoUrl: \'https://commondatastorage.googleapis.com/gtv-videos-bucket/sample/ElephantsDream.mp4\',\n            isFreePreview: false,\n            order: 2,\n          },\n          {\n            id: \'v1_3\',\n            title: \'3. Capital Gains Exemptions (Sec 54, 54B, 54EC, 54F)\',\n            duration: \'35:10\',\n            videoUrl: \'https://commondatastorage.googleapis.com/gtv-videos-bucket/sample/ForBiggerBlazes.mp4\',\n            isFreePreview: false,\n            order: 3,\n          },\n        ],\n        pdfs: [\n          {\n            id: \'p1_1\',\n            title: \'Income Tax Handwritten Revision Notes - Sneha Gupta Special\',\n            type: \'notes\',\n            fileUrl: \'https://www.w3.org/WAI/ER/tests/xhtml/testfiles/resources/pdf/dummy.pdf\',\n            pageCount: 68,\n            sizeMb: \'4.2 MB\',\n          },\n          {\n            id: \'p1_2\',\n            title: \'Top 100 ICAI RTP/MTP Income Tax Question Bank\',\n            type: \'question_bank\',\n            fileUrl: \'https://www.w3.org/WAI/ER/tests/xhtml/testfiles/resources/pdf/dummy.pdf\',\n            pageCount: 112,\n            sizeMb: \'8.5 MB\',\n          },\n        ],\n      },\n      {\n        id: \'ch2\',\n        title: \'GST Essentials & Input Tax Credit (ITC)\',\n        description: \'Levy and collection of GST, Time & Value of Supply, and ITC Rule 36(4) deep dive.\',\n        videos: [\n          {\n            id: \'v2_1\',\n            title: \'1. GST Supply Concepts & Exemptions Summary\',\n            duration: \'31:20\',\n            videoUrl: \'https://commondatastorage.googleapis.com/gtv-videos-bucket/sample/ForBiggerEscapes.mp4\',\n            isFreePreview: true,\n            order: 1,\n          },\n          {\n            id: \'v2_2\',\n            title: \'2. Input Tax Credit Restrictions & Blocked Credits (Sec 17(5))\',\n            duration: \'39:45\',\n            videoUrl: \'https://commondatastorage.googleapis.com/gtv-videos-bucket/sample/ForBiggerFun.mp4\',\n            isFreePreview: false,\n            order: 2,\n          },\n        ],\n        pdfs: [\n          {\n            id: \'p2_1\',\n            title: \'GST Mind Maps & Flowcharts PDF\',\n            type: \'notes\',\n            fileUrl: \'https://www.w3.org/WAI/ER/tests/xhtml/testfiles/resources/pdf/dummy.pdf\',\n            pageCount: 45,\n            sizeMb: \'3.1 MB\',\n          },\n        ],\n      },\n    ],\n  },\n  {\n    id: \'c2\',\n    title: \'CA Inter Cost & Management Accounting - Formula & Numerical Sprint\',\n    subject: \'Costing\',\n    category: \'CA Inter\',\n    group: \'Group 1\',\n    description: \'Master Costing formulas without rote learning. Includes Standard Costing, Marginal Costing, and Activity Based Costing.\',\n    longDescription: \'Struggling with length numericals in CA Inter Costing? Sneha Gupta simplifies all core chapters with logical derivation of formulas, exam time-management strategies, and step-by-step solutions for past 10 attempts ICAI papers.\',\n    thumbnail: \'https://images.unsplash.com/photo-1460925895917-afdab827c52f?auto=format&fit=crop&w=800&q=80\',\n    duration: \'38 Hours\',\n    price: 1299,\n    originalPrice: 2499,\n    rating: 4.8,\n    reviewCount: 289,\n    isFeatured: true,\n    chapters: [\n      {\n        id: \'ch_cost_1\',\n        title: \'Marginal Costing & CVP Analysis\',\n        description: \'P/V Ratio, Break Even Point, Margin of Safety, Key factor decisions.\',\n        videos: [\n          {\n            id: \'v_c1_1\',\n            title: \'1. Marginal Costing Fundamental Equations & Concept Building\',\n            duration: \'34:10\',\n            videoUrl: \'https://commondatastorage.googleapis.com/gtv-videos-bucket/sample/ForBiggerJoyplays.mp4\',\n            isFreePreview: true,\n            order: 1,\n          },\n          {\n            id: \'v_c1_2\',\n            title: \'2. Decision Making Problems & Limiting Factor Calculations\',\n            duration: \'48:30\',\n            videoUrl: \'https://commondatastorage.googleapis.com/gtv-videos-bucket/sample/ForBiggerMeltdowns.mp4\',\n            isFreePreview: false,\n            order: 2,\n          },\n        ],\n        pdfs: [\n          {\n            id: \'p_cost_1\',\n            title: \'Costing Formula Memory Sheet (10 Pages)\',\n            type: \'notes\',\n            fileUrl: \'https://www.w3.org/WAI/ER/tests/xhtml/testfiles/resources/pdf/dummy.pdf\',\n            pageCount: 10,\n            sizeMb: \'1.2 MB\',\n          },\n          {\n            id: \'p_cost_2\',\n            title: \'Costing Past 10 Attempts Suggested Answers Compiled\',\n            type: \'question_bank\',\n            fileUrl: \'https://www.w3.org/WAI/ER/tests/xhtml/testfiles/resources/pdf/dummy.pdf\',\n            pageCount: 140,\n            sizeMb: \'9.8 MB\',\n          },\n        ],\n      },\n    ],\n  },\n  {\n    id: \'c3\',\n    title: \'CA Inter Audit & Ethics - Keywords & SA Retention Bootcamp\',\n    subject: \'Auditing\',\n    category: \'CA Inter\',\n    group: \'Group 2\',\n    description: \'Solve Audit retention fear with Standard on Auditing (SA) mnemonics, technical wording, and mock answer writing.\',\n    longDescription: \'Auditing is often considered a scoring roadblock due to generic language. In this course, Sneha Gupta shares exact ICAI keywords required to score exemptions, SA summaries, Audit of Financial Statement items, and CARO 2020 clause memorizer.\',\n    thumbnail: \'https://images.unsplash.com/photo-1450133064473-71024230f91b?auto=format&fit=crop&w=800&q=80\',\n    duration: \'32 Hours\',\n    price: 1199,\n    originalPrice: 2299,\n    rating: 4.95,\n    reviewCount: 412,\n    isFeatured: true,\n    chapters: [\n      {\n        id: \'ch_aud_1\',\n        title: \'Standards on Auditing (SA 200 Series to SA 700 Series)\',\n        description: \'Crisp coverage of all SAs with audit evidence, risk assessment, and auditor reporting.\',\n        videos: [\n          {\n            id: \'v_a1_1\',\n            title: \'1. SA 200, 210, 220 & Fundamental Principles of Audit\',\n            duration: \'26:15\',\n            videoUrl: \'https://commondatastorage.googleapis.com/gtv-videos-bucket/sample/Sintel.mp4\',\n            isFreePreview: true,\n            order: 1,\n          },\n        ],\n        pdfs: [\n          {\n            id: \'p_aud_1\',\n            title: \'SA Cheat Sheet & Keyword Master Note\',\n            type: \'notes\',\n            fileUrl: \'https://www.w3.org/WAI/ER/tests/xhtml/testfiles/resources/pdf/dummy.pdf\',\n            pageCount: 35,\n            sizeMb: \'2.8 MB\',\n          },\n        ],\n      },\n    ],\n  },\n  {\n    id: \'c4\',\n    title: \'CA Inter Advanced Accounting & AS Express\',\n    subject: \'Advanced Accounting\',\n    category: \'CA Inter\',\n    group: \'Group 1\',\n    description: \'Accounting Standards (AS) simplified along with Consolidation, Amalgamation, and Partnership accounts.\',\n    longDescription: \'Clear all Accounting Standards with practical journal entries, disclosure requirements, and exam-oriented format techniques.\',\n    thumbnail: \'https://images.unsplash.com/photo-1544717305-2782549b5136?auto=format&fit=crop&w=800&q=80\',\n    duration: \'50 Hours\',\n    price: 1699,\n    originalPrice: 3299,\n    rating: 4.85,\n    reviewCount: 198,\n    isFeatured: false,\n    chapters: [\n      {\n        id: \'ch_acc_1\',\n        title: \'High-Weightage Accounting Standards (AS 7, AS 9, AS 18, AS 20, AS 22)\',\n        description: \'Revenue recognition, EPS, Construction Contracts, Deferred Tax Asset/Liability.\',\n        videos: [\n          {\n            id: \'v_acc1\',\n            title: \'1. AS 20 Earnings Per Share - Basic & Diluted EPS Simplified\',\n            duration: \'32:00\',\n            videoUrl: \'https://commondatastorage.googleapis.com/gtv-videos-bucket/sample/SubaruOutbackOnStreet.mp4\',\n            isFreePreview: true,\n            order: 1,\n          },\n        ],\n        pdfs: [\n          {\n            id: \'p_acc1\',\n            title: \'Accounting Standards One-Pager Summaries\',\n            type: \'notes\',\n            fileUrl: \'https://www.w3.org/WAI/ER/tests/xhtml/testfiles/resources/pdf/dummy.pdf\',\n            pageCount: 52,\n            sizeMb: \'3.9 MB\',\n          },\n        ],\n      },\n    ],\n  },\n];\n\nexport const INITIAL_MENTORSHIPS: MentorshipOption[] = [\n  {\n    id: \'m_sept26_single\',\n    examTerm: \'CA Inter Sept 2026\',\n    groupType: \'Single Group\',\n    price: 1500,\n    originalPrice: 2500,\n    description: \'Intensive 12-week structured mentorship for CA Inter Sept 2026 Single Group aspirants.\',\n    benefits: [\n      \'Daily Target Planner & Tracker\',\n      \'24/7 Personal WhatsApp Doubt Support\',\n      \'Weekly Mock Test Evaluation & Feedback\',\n      \'1:1 Bi-Weekly Zoom Mentorship Calls\',\n      \'Subject-wise Time Allocation Strategy\',\n      \'Last 30 Days High-Yield Revision Schedule\',\n    ],\n    weeklyPlan: [\n      { week: \'Week 1-3\', topic: \'Primary Syllabus Completion (60% Weightage)\', goal: \'Finish high-weightage chapters with chapter-end questions\' },\n      { week: \'Week 4-6\', topic: \'Secondary Chapters & MCQ Bank\', goal: \'Complete remaining syllabus & practice 300+ MCQs\' },\n      { week: \'Week 7-9\', topic: \'First Grand Revision & Test Series 1\', goal: \'100% revision + 3-hour exam simulation\' },\n      { week: \'Week 10-12\', topic: \'Second Quick Revision & RTP/MTP Solving\', goal: \'Solve ICAI RTP & Past 3 Attempt papers under timed conditions\' },\n    ],\n  },\n  {\n    id: \'m_sept26_both\',\n    examTerm: \'CA Inter Sept 2026\',\n    groupType: \'Both Groups\',\n    price: 2000,\n    originalPrice: 3500,\n    description: \'Comprehensive dual-group balance strategy for Sept 2026 aspirants aiming for AIR / Exemption.\',\n    benefits: [\n      \'Dual-Group Balance Timetable Generator\',\n      \'24/7 Direct WhatsApp Access to Sneha Gupta\',\n      \'Weekly Chapter Test Evaluation\',\n      \'1:1 Personal Strategy Calls every 10 Days\',\n      \'Group 1 & Group 2 Interleaving Revision Routine\',\n      \'Burnout Management & Mindset Coaching\',\n      \'Free Access to All Summary PDFs\',\n    ],\n    weeklyPlan: [\n      { week: \'Week 1-4\', topic: \'Parallel Group 1 & Group 2 Target Execution\', goal: \'Finish 2 core subjects per day with active recall\' },\n      { week: \'Week 5-8\', topic: \'Advanced Practical Problem Solving\', goal: \'Complete Costing, Tax, Advanced Accounts high marks chapters\' },\n      { week: \'Week 9-11\', topic: \'3-Layer Layered Revision Strategy\', goal: \'Execute 7-day, 3-day, and 1.5-day revision cycles\' },\n      { week: \'Week 12\', topic: \'Final Full Syllabus Mock Tests\', goal: \'Simulate exact exam environment with evaluated feedback\' },\n    ],\n  },\n  {\n    id: \'m_jan27_single\',\n    examTerm: \'CA Inter Jan 2027\',\n    groupType: \'Single Group\',\n    price: 3000,\n    originalPrice: 4500,\n    description: \'Long-term foundational strategy & revision roadmap for Jan 2027 Single Group candidates.\',\n    benefits: [\n      \'Customized 5-Month Master Study Blueprint\',\n      \'Unlimited Doubt Clearing via WhatsApp\',\n      \'Monthly Full Progress Audit & Parent/Student Review\',\n      \'Handwritten Revision Notes Access\',\n      \'ICAI Study Material & Practice Manual Guidance\',\n    ],\n    weeklyPlan: [\n      { week: \'Month 1-2\', topic: \'Conceptual Depth & Fundamental Building\', goal: \'100% conceptual clarity with written practice\' },\n      { week: \'Month 3-4\', topic: \'RTP/MTP Integration & Question Bank\', goal: \'Solve 1500+ questions across all 3/4 subjects\' },\n      { week: \'Month 5\', topic: \'Triple Revision & Exam Temperament\', goal: \'Master 1.5 days before exam preparation\' },\n    ],\n  },\n  {\n    id: \'m_jan27_both\',\n    examTerm: \'CA Inter Jan 2027\',\n    groupType: \'Both Groups\',\n    price: 4000,\n    originalPrice: 6000,\n    description: \'The flagship Both Groups mentorship program for Jan 2027 exam cycle.\',\n    benefits: [\n      \'Complete Both-Group Roadmap & Execution Plan\',\n      \'1:1 Personal Mentorship directly with Sneha Gupta\',\n      \'Priority Evaluation of Answers within 24 Hours\',\n      \'Ranker Mindset & Time Tracking Sheets\',\n      \'Free Access to All Question Bank PDFs & Notes\',\n      \'Special ABC Analysis & Past Trend Reports\',\n    ],\n    weeklyPlan: [\n      { week: \'Month 1-3\', topic: \'First Pass: 100% Concept Mastery\', goal: \'Cover Group 1 & Group 2 sequentially without backlogs\' },\n      { week: \'Month 4\', topic: \'Layer 1 Revision & Mock Exams\', goal: \'Evaluate weak areas with granular feedback\' },\n      { week: \'Month 5\', topic: \'Layer 2 & Layer 3 Speed Revisions\', goal: \'Master quick formulas, memory mnemonics & exam writing\' },\n    ],\n  },\n];\n\nexport const INITIAL_TESTIMONIALS: Testimonial[] = [\n  {\n    id: \'t1\',\n    studentName: \'Rohan Sharma\',\n    studentAttempt: \'CA Inter May 2025\',\n    examScore: \'Taxation: 78/100 (Exemption)\',\n    rating: 5,\n    reviewText: \'Sneha maam GST mind maps and Income Tax section mnemonics were a game changer! I went from failing in Tax mock to scoring 78 in the final ICAI exam. Her 1:1 strategy session cleared my backlog confusion completely.\',\n    avatarUrl: \'https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&w=200&q=80\',\n    whatsappScreenshotUrl: \'https://images.unsplash.com/photo-1618005182384-a83a8bd57fbe?auto=format&fit=crop&w=600&q=80\',\n    verifiedStudent: true,\n    date: \'June 2025\',\n  },\n  {\n    id: \'t2\',\n    studentName: \'Priya Agarwal\',\n    studentAttempt: \'CA Inter Sept 2025\',\n    examScore: \'Passed Both Groups (482/800)\',\n    rating: 5,\n    reviewText: \'Joining Sneha Gupta Both Groups Mentorship was the best decision of my CA journey. She gave me a realistic daily timetable and monitored my progress every single week on WhatsApp. Couldn\342\200\231t have cleared without her constant motivation!\',\n    avatarUrl: \'https://images.unsplash.com/photo-1517841905240-472988babdf9?auto=format&fit=crop&w=200&q=80\',\n    whatsappScreenshotUrl: \'https://images.unsplash.com/photo-1522071820081-009f0129c71c?auto=format&fit=crop&w=600&q=80\',\n    verifiedStudent: true,\n    date: \'October 2025\',\n  },\n  {\n    id: \'t3\',\n    studentName: \'Aman Verma\',\n    studentAttempt: \'CA Inter Jan 2026\',\n    examScore: \'Audit: 68/100 (Exemption)\',\n    rating: 5,\n    reviewText: \'Audit retention was my biggest nightmare. Sneha maam Keyword Bootcamp taught me exactly how to present answers with SA references. Highly recommend her courses and strategy sessions!\',\n    avatarUrl: \'https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?auto=format&fit=crop&w=200&q=80\',\n    verifiedStudent: true,\n    date: \'February 2026\',\n  },\n  {\n    id: \'t4\',\n    studentName: \'Ananya Deshmukh\',\n    studentAttempt: \'CA Inter May 2025\',\n    examScore: \'Costing: 81/100\',\n    rating: 5,\n    reviewText: \'The 1:1 strategy call with Sneha maam gave me a clear 60-day action plan when I was completely overwhelmed. Her formula cheat sheet alone saved me 15+ hours during exam week.\',\n    avatarUrl: \'https://images.unsplash.com/photo-1544005313-94ddf0286df2?auto=format&fit=crop&w=200&q=80\',\n    verifiedStudent: true,\n    date: \'July 2025\',\n  },\n];\n\nexport const FREQUENTLY_ASKED_QUESTIONS = [\n  {\n    question: \'Who is Sneha Gupta?\',\n    answer: \'Sneha Gupta is a CA Finalist, academic mentor, and educator who has guided over 5,000+ CA aspirants to clear CA Inter and Foundation exams. She specializes in high-yield exam strategy, simplified Tax & Audit notes, and structured 1:1 mentorship.\',\n  },\n  {\n    question: \'How do I access courses after purchasing?\',\n    answer: \'Once your Razorpay payment is verified, your purchased course is immediately unlocked in your Student Dashboard under \"My Courses\". You can stream videos, track progress, and download PDF notes & question banks instantly.\',\n  },\n  {\n    question: \'What happens after I enroll in a Mentorship Program?\',\n    answer: \'After payment, you will fill out a short Student Information Form detailing your current preparation level, attempt, and target subjects. Sneha Gupta will reach out to you on WhatsApp within 12 hours with your custom study planner and group access.\',\n  },\n  {\n    question: \'How are 1:1 Personal Strategy Calls conducted?\',\n    answer: \'Strategy sessions (\342\202\271799) are 30-45 minute 1:1 live calls conducted over Google Meet/Zoom. During the call, Sneha analyzes your study history, backlogs, and creates a customized subject-wise timetable and revision plan.\',\n  },\n  {\n    question: \'Are the notes and question banks downloadable and printable?\',\n    answer: \'Yes! All PDF notes, mind maps, and question banks provided in the courses can be viewed directly in our built-in PDF reader or downloaded to your device for offline study and printing.\',\n  },\n  {\n    question: \'Can I request a refund if I am not satisfied?\',\n    answer: \'We maintain a transparent policy. Since digital resources, PDF downloads, and live 1:1 slots are immediately allocated upon booking, fees are generally non-refundable, but we guarantee full support until your exam attempt!\',\n  },\n];\n"
    }
