    replacement_infos {
      original_chunk {
        target_content: "      {/* HERO SECTION */}\n      <section className=\"relative overflow-hidden bg-gradient-to-b from-blue-50/70 via-white to-white dark:from-slate-900 dark:via-slate-900 dark:to-slate-950 pt-8 pb-16 sm:pt-16 sm:pb-24 border-b border-slate-100 dark:border-slate-800\">\n        <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\">\n          <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-12 items-center\">\n            {/* Left Copy & CTAs */}\n            <div className=\"lg:col-span-7 space-y-6 text-left\">\n              {/* Badge */}\n              <div className=\"inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-blue-100 dark:bg-blue-950/60 text-blue-700 dark:text-blue-300 text-xs font-bold border border-blue-200 dark:border-blue-800 shadow-sm\">\n                <Sparkles className=\"w-3.5 h-3.5 text-blue-600\" />\n                <span>Sneha Gupta (CA Finalist) \342\200\242 Academic Mentor</span>\n              </div>\n\n              <h1 className=\"text-3xl sm:text-5xl font-extrabold text-slate-900 dark:text-white tracking-tight leading-[1.15]\">\n                Master CA Inter & Final with{\' \'}\n                <span className=\"text-blue-600 dark:text-blue-400 underline decoration-blue-300 dark:decoration-blue-800 underline-offset-8\">\n                  Targeted Strategy\n                </span>{\' \'}\n                & 1:1 Mentorship\n              </h1>\n\n              <p className=\"text-base sm:text-lg text-slate-600 dark:text-slate-300 leading-relaxed max-w-2xl\">\n                Clear your CA exams with confidence. Chapter-wise fastrack mastery, handwritten summary notes, RTP/MTP question banks, and personalized daily timetables curated by a CA Finalist.\n              </p>\n\n              {/* Stats Strip */}\n              <div className=\"grid grid-cols-3 gap-4 pt-2 pb-2 border-y border-slate-200/60 dark:border-slate-800 max-w-xl\">\n                <div>\n                  <p className=\"text-xl sm:text-2xl font-extrabold text-blue-600 dark:text-blue-400\">5,000+</p>\n                  <p className=\"text-xs text-slate-500 font-medium\">CA Aspirants Mentored</p>\n                </div>\n                <div>\n                  <p className=\"text-xl sm:text-2xl font-extrabold text-emerald-600 dark:text-emerald-400\">94%</p>\n                  <p className=\"text-xs text-slate-500 font-medium\">Exam Pass Rate</p>\n                </div>\n                <div>\n                  <p className=\"text-xl sm:text-2xl font-extrabold text-indigo-600 dark:text-indigo-400\">100+</p>\n                  <p className=\"text-xs text-slate-500 font-medium\">Exemptions in Tax/Audit</p>\n                </div>\n              </div>\n\n              {/* Action Buttons */}\n              <div className=\"flex flex-wrap items-center gap-3 pt-2\">\n                <button\n                  onClick={() => setActiveTab(\'courses\')}\n                  className=\"px-6 py-3.5 bg-blue-600 hover:bg-blue-700 text-white text-sm font-semibold rounded-xl shadow-lg shadow-blue-600/25 flex items-center gap-2 transition active:scale-[0.98]\"\n                >\n                  <BookOpen className=\"w-4 h-4\" />\n                  <span>Explore Fastrack Courses</span>\n                </button>\n\n                <button\n                  onClick={() => setActiveTab(\'mentorship\')}\n                  className=\"px-6 py-3.5 bg-slate-900 hover:bg-slate-800 dark:bg-slate-800 dark:hover:bg-slate-700 text-white text-sm font-semibold rounded-xl shadow-md flex items-center gap-2 transition active:scale-[0.98]\"\n                >\n                  <GraduationCap className=\"w-4 h-4 text-blue-400\" />\n                  <span>Join Mentorship</span>\n                </button>\n\n                <button\n                  onClick={onOpenStrategyModal}\n                  className=\"px-5 py-3.5 bg-amber-50 hover:bg-amber-100 text-amber-900 dark:bg-amber-950/40 dark:text-amber-300 font-semibold rounded-xl text-sm border border-amber-200 dark:border-amber-800 flex items-center gap-1.5 transition\"\n                >\n                  <Zap className=\"w-4 h-4 text-amber-600 fill-amber-500\" />\n                  <span>Book 1:1 Call (\342\202\271799)</span>\n                </button>\n              </div>\n            </div>\n\n            {/* Right Photography Card */}\n            <div className=\"lg:col-span-5 relative\">\n              <div className=\"relative mx-auto max-w-md bg-gradient-to-tr from-blue-600 to-indigo-600 rounded-3xl p-1 shadow-2xl\">\n                <div className=\"bg-white dark:bg-slate-900 rounded-[22px] overflow-hidden p-6 space-y-5\">\n                  <div className=\"relative aspect-[4/3] rounded-2xl overflow-hidden bg-slate-100 dark:bg-slate-800\">\n                    <img\n                      src=\"https://images.unsplash.com/photo-1573496359142-b8d87734a5a2?auto=format&fit=crop&w=800&q=80\"\n                      alt=\"Sneha Gupta CA Finalist\"\n                      className=\"w-full h-full object-cover\"\n                    />\n                    <div className=\"absolute inset-0 bg-gradient-to-t from-slate-950/80 via-transparent to-transparent flex flex-col justify-end p-4 text-white\">\n                      <span className=\"text-[10px] font-bold bg-blue-600 px-2 py-0.5 rounded w-max mb-1\">\n                        CA FINALIST & EDUCATOR\n                      </span>\n                      <h3 className=\"font-bold text-lg\">Sneha Gupta</h3>\n                      <p className=\"text-xs text-blue-200\">Rank Holder Strategy \342\200\242 ICAI Valuation Specialist</p>\n                    </div>\n                  </div>\n\n                  <div className=\"space-y-2 text-xs\">\n                    <div className=\"flex items-center gap-2 p-2.5 bg-blue-50 dark:bg-blue-950/50 rounded-xl text-blue-900 dark:text-blue-200\">\n                      <CheckCircle2 className=\"w-4 h-4 text-blue-600 flex-shrink-0\" />\n                      <span>Specialist in Income Tax, GST, Costing & SA Retention</span>\n                    </div>\n                    <div className=\"flex items-center gap-2 p-2.5 bg-emerald-50 dark:bg-emerald-950/50 rounded-xl text-emerald-900 dark:text-emerald-200\">\n                      <CheckCircle2 className=\"w-4 h-4 text-emerald-600 flex-shrink-0\" />\n                      <span>Custom WhatsApp 1:1 Target Tracking for Students</span>\n                    </div>\n                  </div>\n                </div>\n              </div>\n            </div>\n          </div>\n        </div>\n      </section>"
        replacement_content: "      {/* HERO SECTION - CLEAN MINIMALISM */}\n      <section className=\"relative overflow-hidden bg-white dark:bg-slate-900 pt-8 pb-16 sm:pt-16 sm:pb-24 border-b border-slate-100 dark:border-slate-800\">\n        <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\">\n          <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-12 items-center\">\n            {/* Left Copy & CTAs */}\n            <div className=\"lg:col-span-7 space-y-6 text-left\">\n              {/* Pill Badge */}\n              <div className=\"inline-flex items-center gap-2 px-3.5 py-1 bg-blue-50 dark:bg-blue-950/60 text-[#2563EB] dark:text-blue-300 text-xs font-bold rounded-full w-fit\">\n                <span className=\"flex h-2 w-2 rounded-full bg-[#2563EB]\" />\n                <span>Sneha Gupta (CA Finalist) \342\200\242 Academic Mentor</span>\n              </div>\n\n              <h1 className=\"text-4xl sm:text-6xl font-bold leading-[1.1] text-slate-900 dark:text-white tracking-tight\">\n                Master CA Inter & Final with{\' \'}\n                <span className=\"text-[#2563EB]\">\n                  Targeted Strategy\n                </span>{\' \'}\n                & 1:1 Mentorship\n              </h1>\n\n              <p className=\"text-base sm:text-lg text-slate-500 dark:text-slate-400 leading-relaxed max-w-xl\">\n                Clear your CA exams with confidence. Chapter-wise fastrack mastery, handwritten summary notes, RTP/MTP question banks, and personalized daily timetables curated by a CA Finalist.\n              </p>\n\n              {/* Action Buttons */}\n              <div className=\"flex flex-wrap items-center gap-4 pt-2\">\n                <button\n                  onClick={() => setActiveTab(\'courses\')}\n                  className=\"px-8 py-4 bg-[#2563EB] hover:bg-blue-700 text-white font-bold text-sm rounded-2xl shadow-xl shadow-blue-500/25 flex items-center gap-2 transition active:scale-95\"\n                >\n                  <BookOpen className=\"w-4 h-4\" />\n                  <span>Explore Courses</span>\n                </button>\n\n                <button\n                  onClick={() => setActiveTab(\'mentorship\')}\n                  className=\"px-8 py-4 bg-white border border-slate-200 dark:border-slate-700 text-slate-700 dark:text-slate-200 font-bold text-sm rounded-2xl hover:bg-slate-50 dark:hover:bg-slate-800 flex items-center gap-2 transition active:scale-95\"\n                >\n                  <GraduationCap className=\"w-4 h-4 text-[#2563EB]\" />\n                  <span>Join Mentorship</span>\n                </button>\n\n                <button\n                  onClick={onOpenStrategyModal}\n                  className=\"px-6 py-4 bg-amber-50 hover:bg-amber-100 dark:bg-amber-950/40 dark:text-amber-300 text-amber-900 font-bold text-sm rounded-2xl border border-amber-200 dark:border-amber-800 flex items-center gap-2 transition active:scale-95\"\n                >\n                  <Zap className=\"w-4 h-4 text-amber-600 fill-amber-500\" />\n                  <span>Book Call (\342\202\271799)</span>\n                </button>\n              </div>\n\n              {/* Quick Stats Strip */}\n              <div className=\"flex flex-wrap gap-8 sm:gap-12 border-t border-slate-100 dark:border-slate-800 pt-8 mt-8\">\n                <div>\n                  <p className=\"text-2xl font-bold text-slate-900 dark:text-white\">5,000+</p>\n                  <p className=\"text-xs text-slate-400 font-semibold uppercase tracking-wider mt-0.5\">Students Mentored</p>\n                </div>\n                <div>\n                  <p className=\"text-2xl font-bold text-[#2563EB]\">94%</p>\n                  <p className=\"text-xs text-slate-400 font-semibold uppercase tracking-wider mt-0.5\">Exam Pass Rate</p>\n                </div>\n                <div>\n                  <p className=\"text-2xl font-bold text-emerald-600 dark:text-emerald-400\">100+</p>\n                  <p className=\"text-xs text-slate-400 font-semibold uppercase tracking-wider mt-0.5\">Tax Exemptions</p>\n                </div>\n              </div>\n            </div>\n\n            {/* Right Side Frame */}\n            <div className=\"lg:col-span-5 relative\">\n              <div className=\"bg-slate-50 dark:bg-slate-800/40 rounded-3xl p-6 relative flex items-center justify-center\">\n                {/* Abstract Blur Accents */}\n                <div className=\"absolute w-72 h-72 bg-blue-100 dark:bg-blue-900/30 rounded-full blur-3xl opacity-60 pointer-events-none -top-10 -right-10\" />\n                <div className=\"absolute w-60 h-60 bg-blue-200 dark:bg-blue-800/20 rounded-full blur-3xl opacity-40 pointer-events-none -bottom-10 -left-10\" />\n\n                {/* Portrait Placeholder Container */}\n                <div className=\"relative w-full max-w-[340px] h-[460px] bg-white dark:bg-slate-900 rounded-[36px] shadow-2xl border-8 border-white dark:border-slate-800 overflow-hidden flex flex-col\">\n                  <img\n                    src=\"https://images.unsplash.com/photo-1573496359142-b8d87734a5a2?auto=format&fit=crop&w=800&q=80\"\n                    alt=\"Sneha Gupta CA Finalist\"\n                    className=\"w-full h-full object-cover\"\n                  />\n                  <div className=\"absolute inset-0 bg-gradient-to-t from-slate-950/85 via-slate-950/20 to-transparent flex flex-col justify-end p-6 text-white\">\n                    <span className=\"text-[10px] font-bold bg-[#2563EB] text-white px-2.5 py-0.5 rounded-full w-fit mb-2\">\n                      CA FINALIST & EDUCATOR\n                    </span>\n                    <h3 className=\"font-bold text-xl text-white\">Sneha Gupta</h3>\n                    <p className=\"text-xs text-slate-300\">Rank Holder Strategy Specialist</p>\n                  </div>\n                </div>\n\n                {/* Floating Card */}\n                <div className=\"absolute top-1/4 -left-6 bg-white dark:bg-slate-800 p-4 rounded-2xl shadow-xl border border-blue-50 dark:border-slate-700 hidden sm:flex items-center gap-3\">\n                  <div className=\"w-10 h-10 rounded-xl bg-blue-50 text-[#2563EB] flex items-center justify-center font-bold\">\n                    <ShieldCheck className=\"w-5 h-5\" />\n                  </div>\n                  <div>\n                    <p className=\"text-xs font-bold text-slate-900 dark:text-white\">ICAI Pattern</p>\n                    <p className=\"text-[10px] text-slate-500\">Updated Sept 26 / Jan 27</p>\n                  </div>\n                </div>\n              </div>\n            </div>\n          </div>\n        </div>\n      </section>"
