  file_change {
    absolute_path_uri: "file:///src/components/layout/Navbar.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState, useEffect } from \'react\';\nimport { useAuth } from \'../../context/AuthContext\';\nimport {\n  BookOpen,\n  GraduationCap,\n  Sparkles,\n  User,\n  LogOut,\n  Menu,\n  X,\n  Moon,\n  Sun,\n  ShieldAlert,\n  Award,\n  Calendar,\n  Layers,\n  MessageSquare,\n  Calculator,\n} from \'lucide-react\';\n\ninterface NavbarProps {\n  activeTab: string;\n  setActiveTab: (tab: string) => void;\n  onOpenStudyPlanner: () => void;\n  onOpenAuthModal: () => void;\n}\n\nexport const Navbar: React.FC<NavbarProps> = ({\n  activeTab,\n  setActiveTab,\n  onOpenStudyPlanner,\n  onOpenAuthModal,\n}) => {\n  const { user, isAuthenticated, isAdmin, logout, toggleDemoAdmin } = useAuth();\n  const [isDarkMode, setIsDarkMode] = useState<boolean>(() => {\n    return document.documentElement.classList.contains(\'dark\');\n  });\n  const [isMobileMenuOpen, setIsMobileMenuOpen] = useState(false);\n\n  useEffect(() => {\n    if (isDarkMode) {\n      document.documentElement.classList.add(\'dark\');\n    } else {\n      document.documentElement.classList.remove(\'dark\');\n    }\n  }, [isDarkMode]);\n\n  const navItems = [\n    { id: \'home\', label: \'Home\' },\n    { id: \'courses\', label: \'Courses\' },\n    { id: \'mentorship\', label: \'Mentorship\' },\n    { id: \'strategy\', label: \'Strategy Session\' },\n    { id: \'reviews\', label: \'Reviews\' },\n  ];\n\n  return (\n    <header className=\"sticky top-0 z-40 bg-white/90 dark:bg-slate-900/90 backdrop-blur-md border-b border-slate-200/80 dark:border-slate-800 transition-colors duration-200\">\n      <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\">\n        <div className=\"flex items-center justify-between h-16 sm:h-20\">\n          {/* Logo & Branding */}\n          <div\n            onClick={() => setActiveTab(\'home\')}\n            className=\"flex items-center gap-3 cursor-pointer group\"\n          >\n            <div className=\"w-10 h-10 sm:w-11 sm:h-11 rounded-2xl bg-blue-600 text-white flex items-center justify-center font-bold text-lg shadow-md shadow-blue-600/20 group-hover:scale-105 transition-transform\">\n              SG\n            </div>\n            <div>\n              <div className=\"flex items-center gap-1.5\">\n                <span className=\"font-extrabold text-base sm:text-lg text-slate-900 dark:text-white tracking-tight\">\n                  Sneha Gupta\n                </span>\n                <span className=\"text-[10px] font-bold bg-blue-100 text-blue-700 dark:bg-blue-900/50 dark:text-blue-300 px-2 py-0.5 rounded-full border border-blue-200 dark:border-blue-800\">\n                  CA Finalist\n                </span>\n              </div>\n              <p className=\"text-[11px] text-slate-500 dark:text-slate-400 font-medium\">\n                CA Inter & Final Mentorship\n              </p>\n            </div>\n          </div>\n\n          {/* Desktop Navigation Links */}\n          <nav className=\"hidden md:flex items-center gap-1 lg:gap-2\">\n            {navItems.map((item) => (\n              <button\n                key={item.id}\n                onClick={() => setActiveTab(item.id)}\n                className={`px-3.5 py-2 text-sm font-semibold rounded-xl transition ${\n                  activeTab === item.id\n                    ? \'text-blue-600 dark:text-blue-400 bg-blue-50 dark:bg-blue-950/50\'\n                    : \'text-slate-600 dark:text-slate-300 hover:text-blue-600 hover:bg-slate-50 dark:hover:bg-slate-800\'\n                }`}\n              >\n                {item.label}\n              </button>\n            ))}\n\n            <button\n              onClick={onOpenStudyPlanner}\n              className=\"px-3 py-2 text-xs font-semibold text-indigo-600 dark:text-indigo-400 bg-indigo-50 dark:bg-indigo-950/50 rounded-xl hover:bg-indigo-100 transition flex items-center gap-1.5\"\n            >\n              <Calculator className=\"w-3.5 h-3.5\" />\n              <span>Study Planner</span>\n            </button>\n          </nav>\n\n          {/* Right Controls */}\n          <div className=\"hidden md:flex items-center gap-3\">\n            {/* Dark Mode Toggle */}\n            <button\n              onClick={() => setIsDarkMode(!isDarkMode)}\n              className=\"p-2 text-slate-500 hover:text-slate-800 dark:text-slate-400 dark:hover:text-white hover:bg-slate-100 dark:hover:bg-slate-800 rounded-xl transition\"\n              title=\"Toggle Dark/Light Mode\"\n            >\n              {isDarkMode ? <Sun className=\"w-5 h-5 text-amber-400\" /> : <Moon className=\"w-5 h-5\" />}\n            </button>\n\n            {/* Admin Toggle Button for Easy Testing */}\n            <button\n              onClick={toggleDemoAdmin}\n              className={`px-2.5 py-1.5 text-xs font-bold rounded-xl transition flex items-center gap-1.5 border ${\n                isAdmin\n                  ? \'bg-amber-500/10 text-amber-600 border-amber-300 dark:text-amber-400\'\n                  : \'bg-slate-100 text-slate-600 border-slate-200 dark:bg-slate-800 dark:text-slate-400 dark:border-slate-700\'\n              }`}\n              title=\"Switch between Student and Admin mode\"\n            >\n              <ShieldAlert className=\"w-3.5 h-3.5\" />\n              <span>{isAdmin ? \'Admin Mode ON\' : \'Switch to Admin\'}</span>\n            </button>\n\n            {/* User Auth state */}\n            {isAuthenticated ? (\n              <div className=\"flex items-center gap-2\">\n                <button\n                  onClick={() => setActiveTab(\'dashboard\')}\n                  className={`px-4 py-2 text-xs font-bold rounded-xl transition shadow-sm flex items-center gap-2 ${\n                    activeTab === \'dashboard\'\n                      ? \'bg-blue-600 text-white\'\n                      : \'bg-slate-100 hover:bg-slate-200 dark:bg-slate-800 dark:text-slate-200 text-slate-800\'\n                  }`}\n                >\n                  <User className=\"w-3.5 h-3.5\" />\n                  <span>My Dashboard</span>\n                </button>\n\n                {isAdmin && (\n                  <button\n                    onClick={() => setActiveTab(\'admin\')}\n                    className={`px-3 py-2 text-xs font-bold rounded-xl transition ${\n                      activeTab === \'admin\'\n                        ? \'bg-amber-600 text-white\'\n                        : \'bg-amber-100 text-amber-800 dark:bg-amber-900/40 dark:text-amber-300\'\n                    }`}\n                  >\n                    Admin Panel\n                  </button>\n                )}\n\n                <button\n                  onClick={logout}\n                  className=\"p-2 text-slate-400 hover:text-red-600 hover:bg-red-50 dark:hover:bg-red-950/30 rounded-xl transition\"\n                  title=\"Logout\"\n                >\n                  <LogOut className=\"w-4 h-4\" />\n                </button>\n              </div>\n            ) : (\n              <button\n                onClick={onOpenAuthModal}\n                className=\"px-5 py-2.5 text-xs font-bold bg-blue-600 hover:bg-blue-700 text-white rounded-xl shadow-md shadow-blue-600/20 transition flex items-center gap-1.5\"\n              >\n                <User className=\"w-3.5 h-3.5\" />\n                <span>Student Login</span>\n              </button>\n            )}\n          </div>\n\n          {/* Mobile Menu Toggle */}\n          <div className=\"flex items-center gap-2 md:hidden\">\n            <button\n              onClick={() => setIsDarkMode(!isDarkMode)}\n              className=\"p-2 text-slate-500 dark:text-slate-400 rounded-xl\"\n            >\n              {isDarkMode ? <Sun className=\"w-5 h-5 text-amber-400\" /> : <Moon className=\"w-5 h-5\" />}\n            </button>\n            <button\n              onClick={() => setIsMobileMenuOpen(!isMobileMenuOpen)}\n              className=\"p-2 text-slate-700 dark:text-slate-200 rounded-xl focus:outline-none\"\n            >\n              {isMobileMenuOpen ? <X className=\"w-6 h-6\" /> : <Menu className=\"w-6 h-6\" />}\n            </button>\n          </div>\n        </div>\n      </div>\n\n      {/* Mobile Drawer Menu */}\n      {isMobileMenuOpen && (\n        <div className=\"md:hidden border-b border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 px-4 pt-2 pb-6 space-y-3 animate-in slide-in-from-top-2 duration-200\">\n          <div className=\"space-y-1\">\n            {navItems.map((item) => (\n              <button\n                key={item.id}\n                onClick={() => {\n                  setActiveTab(item.id);\n                  setIsMobileMenuOpen(false);\n                }}\n                className={`w-full text-left px-4 py-3 rounded-xl font-semibold text-sm transition ${\n                  activeTab === item.id\n                    ? \'bg-blue-50 text-blue-600 dark:bg-blue-950/50 dark:text-blue-400\'\n                    : \'text-slate-700 dark:text-slate-300\'\n                }`}\n              >\n                {item.label}\n              </button>\n            ))}\n            <button\n              onClick={() => {\n                onOpenStudyPlanner();\n                setIsMobileMenuOpen(false);\n              }}\n              className=\"w-full text-left px-4 py-3 rounded-xl font-semibold text-sm text-indigo-600 dark:text-indigo-400 bg-indigo-50 dark:bg-indigo-950/40 flex items-center gap-2\"\n            >\n              <Calculator className=\"w-4 h-4\" />\n              <span>Smart Study Planner</span>\n            </button>\n          </div>\n\n          <div className=\"pt-2 border-t border-slate-100 dark:border-slate-800 flex flex-col gap-2\">\n            <button\n              onClick={() => {\n                toggleDemoAdmin();\n                setIsMobileMenuOpen(false);\n              }}\n              className=\"w-full py-2.5 px-4 text-xs font-bold rounded-xl bg-amber-500/10 text-amber-600 border border-amber-300 flex items-center justify-center gap-2\"\n            >\n              <ShieldAlert className=\"w-4 h-4\" />\n              <span>{isAdmin ? \'Admin Mode Active\' : \'Switch to Admin Demo\'}</span>\n            </button>\n\n            {isAuthenticated ? (\n              <>\n                <button\n                  onClick={() => {\n                    setActiveTab(\'dashboard\');\n                    setIsMobileMenuOpen(false);\n                  }}\n                  className=\"w-full py-3 bg-blue-600 text-white font-bold rounded-xl text-sm\"\n                >\n                  My Student Dashboard\n                </button>\n                {isAdmin && (\n                  <button\n                    onClick={() => {\n                      setActiveTab(\'admin\');\n                      setIsMobileMenuOpen(false);\n                    }}\n                    className=\"w-full py-3 bg-amber-600 text-white font-bold rounded-xl text-sm\"\n                  >\n                    Admin Dashboard\n                  </button>\n                )}\n                <button\n                  onClick={() => {\n                    logout();\n                    setIsMobileMenuOpen(false);\n                  }}\n                  className=\"w-full py-2.5 text-red-600 text-xs font-bold hover:bg-red-50 rounded-xl\"\n                >\n                  Logout\n                </button>\n              </>\n            ) : (\n              <button\n                onClick={() => {\n                  onOpenAuthModal();\n                  setIsMobileMenuOpen(false);\n                }}\n                className=\"w-full py-3 bg-blue-600 text-white font-bold rounded-xl text-sm\"\n              >\n                Student Login / Register\n              </button>\n            )}\n          </div>\n        </div>\n      )}\n    </header>\n  );\n};\n"
