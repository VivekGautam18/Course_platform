        target_content: "      {/* Title */}\n      <div className=\"text-center max-w-2xl mx-auto space-y-3\">\n        <span className=\"text-xs font-bold text-blue-600 dark:text-blue-400 uppercase tracking-widest bg-blue-50 dark:bg-blue-950/60 px-3 py-1 rounded-full\">\n          Personal Guidance Engine\n        </span>\n        <h1 className=\"text-3xl sm:text-4xl font-extrabold text-slate-900 dark:text-white\">\n          Sneha Gupta Structured Mentorship\n        </h1>\n        <p className=\"text-sm text-slate-600 dark:text-slate-400\">\n          Transform your exam preparation with customized weekly targets, 24/7 direct WhatsApp access, and 1:1 strategy calls.\n        </p>\n      </div>\n\n      {/* Filter Tabs */}\n      <div className=\"flex justify-center gap-2\">\n        <button\n          onClick={() => setSelectedExam(\'all\')}\n          className={`px-4 py-2 text-xs font-bold rounded-xl transition ${\n            selectedExam === \'all\'\n              ? \'bg-blue-600 text-white shadow-md\'\n              : \'bg-slate-100 text-slate-700 dark:bg-slate-800 dark:text-slate-300\'\n          }`}\n        >\n          All Programs\n        </button>\n        <button\n          onClick={() => setSelectedExam(\'CA Inter Sept 2026\')}\n          className={`px-4 py-2 text-xs font-bold rounded-xl transition ${\n            selectedExam === \'CA Inter Sept 2026\'\n              ? \'bg-blue-600 text-white shadow-md\'\n              : \'bg-slate-100 text-slate-700 dark:bg-slate-800 dark:text-slate-300\'\n          }`}\n        >\n          CA Inter Sept 2026\n        </button>\n        <button\n          onClick={() => setSelectedExam(\'CA Inter Jan 2027\')}\n          className={`px-4 py-2 text-xs font-bold rounded-xl transition ${\n            selectedExam === \'CA Inter Jan 2027\'\n              ? \'bg-blue-600 text-white shadow-md\'\n              : \'bg-slate-100 text-slate-700 dark:bg-slate-800 dark:text-slate-300\'\n          }`}\n        >\n          CA Inter Jan 2027\n        </button>\n      </div>"
        replacement_content: "      {/* Title */}\n      <div className=\"text-center max-w-2xl mx-auto space-y-3\">\n        <div className=\"inline-flex items-center gap-2 px-3 py-1 bg-blue-50 dark:bg-blue-950/60 text-[#2563EB] dark:text-blue-300 text-xs font-bold rounded-full w-fit mx-auto\">\n          <span className=\"flex h-2 w-2 rounded-full bg-[#2563EB]\" />\n          <span>Personal Guidance Engine</span>\n        </div>\n        <h1 className=\"text-3xl sm:text-4xl font-bold text-slate-900 dark:text-white\">\n          Sneha Gupta Mentorship\n        </h1>\n        <p className=\"text-sm text-slate-500 dark:text-slate-400\">\n          Transform your exam preparation with customized weekly targets, 24/7 direct WhatsApp access, and 1:1 strategy calls.\n        </p>\n      </div>\n\n      {/* Filter Tabs */}\n      <div className=\"flex justify-center flex-wrap gap-2\">\n        <button\n          onClick={() => setSelectedExam(\'all\')}\n          className={`px-5 py-2 text-xs font-semibold rounded-full transition ${\n            selectedExam === \'all\'\n              ? \'bg-[#2563EB] text-white shadow-md shadow-blue-500/20\'\n              : \'bg-slate-100 text-slate-700 dark:bg-slate-800 dark:text-slate-300 hover:bg-slate-200\'\n          }`}\n        >\n          All Programs\n        </button>\n        <button\n          onClick={() => setSelectedExam(\'CA Inter Sept 2026\')}\n          className={`px-5 py-2 text-xs font-semibold rounded-full transition ${\n            selectedExam === \'CA Inter Sept 2026\'\n              ? \'bg-[#2563EB] text-white shadow-md shadow-blue-500/20\'\n              : \'bg-slate-100 text-slate-700 dark:bg-slate-800 dark:text-slate-300 hover:bg-slate-200\'\n          }`}\n        >\n          CA Inter Sept 2026\n        </button>\n        <button\n          onClick={() => setSelectedExam(\'CA Inter Jan 2027\')}\n          className={`px-5 py-2 text-xs font-semibold rounded-full transition ${\n            selectedExam === \'CA Inter Jan 2027\'\n              ? \'bg-[#2563EB] text-white shadow-md shadow-blue-500/20\'\n              : \'bg-slate-100 text-slate-700 dark:bg-slate-800 dark:text-slate-300 hover:bg-slate-200\'\n          }`}\n        >\n          CA Inter Jan 2027\n        </button>\n      </div>"
